# Salin ke .env.local (lokal) dan isi sebagai Secrets di Cloudflare Workers
DATABASE_URL="postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require"
SESSION_SECRET="isi-string-acak-minimal-32-karakter"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# Login Google (opsional; tombol hanya muncul jika keduanya terisi)
GOOGLE_CLIENT_ID=isi-dengan-client-id-dari-google-cloud
GOOGLE_CLIENT_SECRET=isi-dengan-client-secret-dari-google-cloud
# Hanya untuk pengembangan lokal (di produksi boleh dikosongkan)
# SITE_URL=http://localhost:3000
